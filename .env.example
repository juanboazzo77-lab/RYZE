# =====================================================================
# FitAI - variables de entorno
# Copiá este archivo como  .env  y completá los valores.
# NO subas .env al repositorio (ya está en .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# Base de datos (Supabase -> botón "Connect" -> pestaña "ORMs" -> Prisma)
# ---------------------------------------------------------------------
# Transaction pooler (puerto 6543). Lo usa la app en runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session pooler / conexión directa (puerto 5432). Lo usan las migraciones de Prisma.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------
# Supabase API (Project Settings -> API)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"

# Project API keys -> "anon" / "public". Se puede exponer al cliente.
NEXT_PUBLIC_SUPABASE_ANON_KEY="PEGAR_ANON_KEY"

# Project API keys -> "service_role" / "secret". SOLO SERVIDOR. Nunca al cliente.
SUPABASE_SERVICE_ROLE_KEY="PEGAR_SERVICE_ROLE_KEY"

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------
# IA — AI Coach y generación de planes
# ---------------------------------------------------------------------
# Proveedor activo: "gemini" (default) o "anthropic".
AI_PROVIDER="gemini"
# Gemini: key gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=""
AI_MODEL="gemini-3.5-flash-lite"
AI_MODEL_FAST="gemini-3.5-flash-lite"
# Sólo si AI_PROVIDER="anthropic":
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------
# Cron (recordatorios semanales). Requerido para /api/cron/worker.
# Generá algo aleatorio: `openssl rand -hex 32`
# ---------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------
# Integraciones externas (fases futuras. Dejar vacío por ahora)
# ---------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NUTRITION_API_KEY=
