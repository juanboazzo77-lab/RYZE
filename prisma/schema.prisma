// =====================================================================
// FitAI — Esquema Prisma
// App mono-usuario. Toda tabla del usuario lleva `user_id` y RLS
// `user_id = auth.uid()` (se agrega a mano en la migración; ver
// prisma/MIGRATIONS.md). El acceso desde la app pasa SIEMPRE por
// `forUser(userId)` (src/server/user-db.ts).
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum Locale {
  ES
  EN
  PT
  FR
  DE
  IT
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PrimaryGoal {
  LOSE_FAT
  GAIN_MUSCLE
  RECOMP
  MAINTAIN
  STRENGTH
  PERFORMANCE
  /// El usuario no sabe qué objetivo elegir; el Coach lo recomienda (con fotos).
  UNDECIDED
}

enum TrainingPlace {
  GYM
  HOME
  BOTH
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
  SUPERSEDED
}

enum NutritionTargetSource {
  MANUAL
  CALCULATED
  AI
}

enum MealType {
  BREAKFAST
  LUNCH
  MERIENDA
  DINNER
  SNACK
}

enum FoodSource {
  SYSTEM
  USER
  API
}

enum FoodEntrySource {
  MANUAL
  AI_PARSE
  FREQUENT
  COPIED
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  ABS
  TRAPS
  FULL_BODY
  OTHER
}

enum PlanSource {
  MANUAL
  AI
}

enum ExerciseType {
  STRENGTH
  CARDIO
}

enum WorkoutStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED
}

enum PrType {
  MAX_WEIGHT
  MAX_REPS
  MAX_VOLUME
  EST_1RM
}

enum EntitlementTier {
  /// Cuenta nueva: prueba gratis por `TRIAL_DAYS` (ver src/server/entitlements.ts).
  /// Pasado ese plazo, FREE queda bloqueada para IA hasta pasar a BASIC o más.
  FREE
  /// Plan de entrada pago ($2.99/mes): mensajes/planes limitados, sin anuncios.
  BASIC
  PRO
  /// Plan más top: entrenador de verdad — desbloquea el perfil de coaching y
  /// la individualización 100% a medida en todos los planes que arma la IA.
  COACH
}

enum EntitlementStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AiConversationKind {
  COACH
  PLAN_INTERVIEW
  CHECKIN
}

enum AiRole {
  USER
  ASSISTANT
}

enum AiGenerationKind {
  WORKOUT_PLAN
  NUTRITION_PLAN
  ADJUSTMENT
}

enum AiGenerationStatus {
  DRAFT
  ACCEPTED
  REJECTED
}

enum AiDraftKind {
  WORKOUT_PLAN
  NUTRITION_TARGETS
  ADJUSTMENT
}

enum AiDraftStatus {
  PROPOSED
  CONFIRMED
  APPLIED
  REJECTED
  EXPIRED
}

enum CheckinStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPLIED
}

enum NotificationKind {
  WEIGH_IN
  WORKOUT_TODAY
  LOG_MEALS
  WEEKLY_CHECKIN
  PROTEIN_GOAL
  STREAK
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

// ---------------------------------------------------------------------
// IDENTIDAD / OBJETIVOS
// ---------------------------------------------------------------------

/// Fila espejo de auth.users (id compartido). El trigger `handle_new_user`
/// la crea al registrarse. La FK a auth.users se agrega en la migración.
model Profile {
  id                     String           @id @db.Uuid
  email                  String
  /// Los cambios que el cliente le pide al coach (rutina, calorías) se aplican solos, sin tocar "Editar".
  coachAutoApply         Boolean          @default(false) @map("coach_auto_apply")
  name                   String?
  sex                    Sex?
  birthdate              DateTime?        @db.Date
  heightCm               Float?           @map("height_cm")
  experienceLevel        ExperienceLevel? @map("experience_level")
  primaryGoal            PrimaryGoal?     @map("primary_goal")
  trainingPlace          TrainingPlace?   @map("training_place")
  activityLevel          ActivityLevel?   @map("activity_level")
  daysAvailable          Int?             @map("days_available")
  sessionMinutes         Int?             @map("session_minutes")
  equipment              Json             @default("[]")
  musclePriorities       Json             @default("[]") @map("muscle_priorities")
  dislikedExercises      Json             @default("[]") @map("disliked_exercises")
  routineStyle           String?          @map("routine_style")
  sportPriority          String?          @map("sport_priority")
  dietaryPrefs           Json             @default("[]") @map("dietary_prefs")
  excludedFoods          Json             @default("[]") @map("excluded_foods")
  allergies              Json             @default("[]")
  mealsPerDay            Int?             @map("meals_per_day")
  trainingExperienceNote String?          @map("training_experience_note")
  injuries               String?
  locale                 Locale           @default(ES)
  unitSystem             UnitSystem       @default(METRIC) @map("unit_system")
  timezone               String           @default("America/Argentina/Buenos_Aires")
  weekStart              Int              @default(1) @map("week_start")
  onboardingCompletedAt  DateTime?        @map("onboarding_completed_at")
  /// Código para invitar amigos (y para que un amigo lo agregue). Se genera la primera vez que se pide.
  referralCode           String?          @unique @map("referral_code")
  /// Quién lo invitó (se usó su código al empezar). Sólo se puede fijar una vez.
  referredById           String?          @db.Uuid @map("referred_by_id")
  referredBy             Profile?         @relation("Referral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals              Profile[]        @relation("Referral")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  goals                   Goal[]
  nutritionTargets        NutritionTarget[]
  entitlement             Entitlement?
  foodsCreated            Food[]                   @relation("FoodCreatedBy")
  foodEntries             FoodEntry[]
  meals                   Meal[]
  exercisesCreated        Exercise[]               @relation("ExerciseCreatedBy")
  workoutPlans            WorkoutPlan[]
  workouts                Workout[]
  personalRecords         PersonalRecord[]
  weightEntries           WeightEntry[]
  aiConversations         AiConversation[]
  aiGenerations           AiGeneration[]
  aiActionDrafts          AiActionDraft[]
  aiUsageDaily            AiUsageDaily[]
  weeklyCheckins          WeeklyCheckin[]
  userAchievements        UserAchievement[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  deviceTokens            DeviceToken[]
  gymMembership           GymMember?
  challengeEntries        GymChallengeEntry[]
  gymBookings             GymBooking[]
  gymReferral             GymReferral?
  webSubscription         WebSubscription?
  ownedGyms               Gym[]     @relation("GymOwner")
  dailyActivities         DailyActivity[]
  sportProfiles           SportProfile[]
  physiqueAnalyses        PhysiqueAnalysis[]
  coachMemories           CoachMemory[]
  competitions            Competition[]
  coachProfile            CoachProfile?
  friendshipsSent         Friendship[]             @relation("FriendshipRequester")
  friendshipsReceived     Friendship[]             @relation("FriendshipAddressee")

  @@index([referredById])
  @@map("profile")
}

model Goal {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid @map("user_id")
  user           Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           PrimaryGoal
  startWeightKg  Float?      @map("start_weight_kg")
  targetWeightKg Float?      @map("target_weight_kg")
  weeklyRateKg   Float?      @map("weekly_rate_kg")
  targetDate     DateTime?   @db.Date @map("target_date")
  status         GoalStatus  @default(ACTIVE)
  note           String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, status])
  @@map("goal")
}

model NutritionTarget {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @db.Uuid @map("user_id")
  user          Profile               @relation(fields: [userId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime              @db.Date @map("effective_from")
  kcal          Int
  proteinG      Int                   @map("protein_g")
  carbsG        Int                   @map("carbs_g")
  fatG          Int                   @map("fat_g")
  source        NutritionTargetSource @default(CALCULATED)
  active        Boolean               @default(true)
  /** Explicación breve de por qué se calcularon estos números para este usuario. */
  rationale     String?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, active])
  @@map("nutrition_target")
}

model Entitlement {
  userId               String            @id @db.Uuid @map("user_id")
  user                 Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                 EntitlementTier   @default(FREE)
  status               EntitlementStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?         @map("current_period_end")
  /// Días de acceso completo regalados (invitaciones): se suman a la prueba gratis.
  bonusUntil           DateTime?         @map("bonus_until")
  lemonSqueezyCustomerId     String?     @map("lemon_squeezy_customer_id")
  lemonSqueezySubscriptionId String?     @map("lemon_squeezy_subscription_id")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@map("entitlement")
}

/// Amistad entre dos usuarios (se crea al usar el código del otro). Es de los dos: no es un
/// modelo "del usuario" para forUser; se accede desde src/server/friends.ts.
model Friendship {
  id          String   @id @default(uuid()) @db.Uuid
  requesterId String   @db.Uuid @map("requester_id")
  requester   Profile  @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String   @db.Uuid @map("addressee_id")
  addressee   Profile  @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendship")
}

// ---------------------------------------------------------------------
// NUTRICIÓN
// ---------------------------------------------------------------------

/// Biblioteca de alimentos. Valores nutricionales por 100 g/ml.
model Food {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  brand         String?
  source        FoodSource @default(USER)
  externalId    String?    @unique @map("external_id")
  createdById   String?    @db.Uuid @map("created_by")
  createdBy     Profile?   @relation("FoodCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  verified      Boolean    @default(false)
  kcalPer100    Float      @map("kcal_per_100")
  proteinPer100 Float      @map("protein_per_100")
  carbsPer100   Float      @map("carbs_per_100")
  fatPer100     Float      @map("fat_per_100")
  servingQty    Float?     @map("serving_qty")
  servingUnit   String?    @map("serving_unit")
  servingLabel  String?    @map("serving_label")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  entries   FoodEntry[]
  mealItems MealItem[]

  @@index([createdById])
  @@index([source])
  @@map("food")
}

model FoodEntry {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid @map("user_id")
  user        Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime        @db.Date
  mealType    MealType        @map("meal_type")
  foodId      String?         @db.Uuid @map("food_id")
  food        Food?           @relation(fields: [foodId], references: [id], onDelete: SetNull)
  customName  String?         @map("custom_name")
  quantity    Float
  unit        String
  kcal        Float
  proteinG    Float           @map("protein_g")
  carbsG      Float           @map("carbs_g")
  fatG        Float           @map("fat_g")
  isEstimated Boolean         @default(false) @map("is_estimated")
  source      FoodEntrySource @default(MANUAL)
  position    Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([foodId])
  @@map("food_entry")
}

/// Comida guardada / frecuente, reutilizable en cualquier día.
model Meal {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid @map("user_id")
  user       Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  isFavorite Boolean    @default(false) @map("is_favorite")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  items      MealItem[]

  @@index([userId])
  @@map("meal")
}

model MealItem {
  id         String  @id @default(uuid()) @db.Uuid
  mealId     String  @db.Uuid @map("meal_id")
  meal       Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodId     String? @db.Uuid @map("food_id")
  food       Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)
  customName String? @map("custom_name")
  quantity   Float
  unit       String
  kcal       Float
  proteinG   Float   @map("protein_g")
  carbsG     Float   @map("carbs_g")
  fatG       Float   @map("fat_g")
  position   Int     @default(0)

  @@index([mealId])
  @@index([foodId])
  @@map("meal_item")
}

// ---------------------------------------------------------------------
// ENTRENAMIENTO
// ---------------------------------------------------------------------

/// Biblioteca de ejercicios (globales + personalizados del usuario).
model Exercise {
  id               String       @id @default(uuid()) @db.Uuid
  name             String
  type             ExerciseType @default(STRENGTH)
  primaryMuscle    MuscleGroup @map("primary_muscle")
  secondaryMuscles Json        @default("[]") @map("secondary_muscles")
  equipment        String?
  /** Cues de técnica (array de strings). Se completan con IA la 1ª vez y se cachean. */
  cues             Json        @default("[]")
  guideGeneratedAt DateTime?   @map("guide_generated_at")
  isCustom         Boolean     @default(false) @map("is_custom")
  createdById      String?     @db.Uuid @map("created_by")
  createdBy        Profile?    @relation("ExerciseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  planExercises    PlanExercise[]
  workoutExercises WorkoutExercise[]
  personalRecords  PersonalRecord[]

  @@index([createdById])
  @@index([primaryMuscle])
  @@map("exercise")
}

model WorkoutPlan {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid @map("user_id")
  user           Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean    @default(false) @map("is_active")
  source         PlanSource @default(MANUAL)
  aiGenerationId String?    @db.Uuid @map("ai_generation_id")
  /// Corrimiento de los días de la semana ("hoy no pude entrenar"): sólo vale para la semana que
  /// empieza en `weekShiftStart`; después los días vuelven a los de siempre (`PlanDay.weekday`).
  weekShift      Int        @default(0) @map("week_shift")
  weekShiftStart DateTime?  @db.Date @map("week_shift_start")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  days     PlanDay[]
  workouts Workout[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("workout_plan")
}

model PlanDay {
  id         String      @id @default(uuid()) @db.Uuid
  planId     String      @db.Uuid @map("plan_id")
  plan       WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int         @map("order_index")
  weekday    Int?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  exercises PlanExercise[]
  workouts  Workout[]

  @@index([planId])
  @@map("plan_day")
}

model PlanExercise {
  id            String   @id @default(uuid()) @db.Uuid
  planDayId     String   @db.Uuid @map("plan_day_id")
  planDay       PlanDay  @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  exerciseId    String   @db.Uuid @map("exercise_id")
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  orderIndex    Int      @map("order_index")
  targetSets    Int      @map("target_sets")
  targetRepsMin Int?     @map("target_reps_min")
  targetRepsMax Int?     @map("target_reps_max")
  targetRir     Float?   @map("target_rir")
  restSeconds   Int?     @map("rest_seconds")
  /** Duración objetivo para ejercicios de cardio (segundos). */
  targetDurationSec    Int?   @map("target_duration_sec")
  /** Distancia objetivo para ejercicios de cardio (metros). */
  targetDistanceMeters Float? @map("target_distance_meters")
  notes         String?
  /** Explicación breve de por qué la IA eligió este ejercicio para este usuario. */
  rationale     String?

  @@index([planDayId])
  @@index([exerciseId])
  @@map("plan_exercise")
}

/// Una sesión de entrenamiento (planificada o realizada).
model Workout {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid @map("user_id")
  user            Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String?       @db.Uuid @map("plan_id")
  plan            WorkoutPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  planDayId       String?       @db.Uuid @map("plan_day_id")
  planDay         PlanDay?      @relation(fields: [planDayId], references: [id], onDelete: SetNull)
  name            String
  status          WorkoutStatus @default(PENDING)
  scheduledFor    DateTime?     @db.Date @map("scheduled_for")
  startedAt       DateTime?     @map("started_at")
  finishedAt      DateTime?     @map("finished_at")
  durationSeconds Int?          @map("duration_seconds")
  perceivedEffort Int?          @map("perceived_effort")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  exercises       WorkoutExercise[]
  personalRecords PersonalRecord[]

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([userId, scheduledFor])
  @@index([planId])
  @@index([planDayId])
  @@map("workout")
}

model WorkoutExercise {
  id            String   @id @default(uuid()) @db.Uuid
  workoutId     String   @db.Uuid @map("workout_id")
  workout       Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId    String   @db.Uuid @map("exercise_id")
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  orderIndex    Int      @map("order_index")
  // Objetivos copiados del plan al iniciar la sesión (editables durante el entreno).
  targetRepsMin Int?     @map("target_reps_min")
  targetRepsMax Int?     @map("target_reps_max")
  targetRir     Float?   @map("target_rir")
  restSeconds   Int?     @map("rest_seconds")
  targetDurationSec    Int?   @map("target_duration_sec")
  targetDistanceMeters Float? @map("target_distance_meters")
  notes         String?

  sets WorkoutSet[]

  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_exercise")
}

model WorkoutSet {
  id                String          @id @default(uuid()) @db.Uuid
  workoutExerciseId String          @db.Uuid @map("workout_exercise_id")
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int             @map("set_number")
  weightKg          Float?          @map("weight_kg")
  reps              Int?
  /** Duración del bloque de cardio (segundos). */
  durationSeconds   Int?            @map("duration_seconds")
  /** Distancia recorrida en el bloque de cardio (metros). */
  distanceMeters    Float?          @map("distance_meters")
  rir               Float?
  rpe               Float?
  isWarmup          Boolean         @default(false) @map("is_warmup")
  isCompleted       Boolean         @default(false) @map("is_completed")
  completedAt       DateTime?       @map("completed_at")

  @@index([workoutExerciseId])
  @@map("workout_set")
}

model PersonalRecord {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String   @db.Uuid @map("exercise_id")
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  type       PrType
  value      Float
  unit       String   @default("kg")
  workoutId  String?  @db.Uuid @map("workout_id")
  workout    Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  achievedAt DateTime @map("achieved_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, exerciseId, type])
  @@index([exerciseId])
  @@map("personal_record")
}

// ---------------------------------------------------------------------
// PROGRESO
// ---------------------------------------------------------------------

model WeightEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  weightKg  Float    @map("weight_kg")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId, date])
  @@map("weight_entry")
}

/// Actividad diaria (pasos y minutos activos). Cargada a mano; deja el terreno
/// listo para una sync con Health Connect / Google Fit desde una app nativa.
model DailyActivity {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid @map("user_id")
  user          Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  steps         Int
  activeMinutes Int?     @map("active_minutes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_activity")
}

/// Un deporte que practica el usuario además del gimnasio. El gimnasio es
/// complementario a esto; el AI Coach programa fuerza y nutrición alrededor de
/// las sesiones de deporte y de las competencias.
model SportProfile {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid @map("user_id")
  user            Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  /// recreativo / amateur / competitivo / profesional
  level           String?
  sessionsPerWeek Int           @default(3) @map("sessions_per_week")
  /// Días de la semana con sesión de deporte (1 = lunes … 7 = domingo).
  sessionDays     Json          @default("[]") @map("session_days")
  goal            String?
  notes           String?
  isPrimary       Boolean       @default(false) @map("is_primary")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  competitions    Competition[]

  @@index([userId])
  @@map("sport_profile")
}

/// Análisis de físico por foto (IA). Se guarda sólo el informe en texto; las fotos
/// nunca se almacenan.
/// Memoria del coach: hechos duraderos que el usuario contó (lesiones, gustos, horarios, restricciones).
/// Los anota el coach a partir del chat o los agrega el propio usuario; se pueden borrar.
model CoachMemory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// HEALTH | PREFERENCE | SCHEDULE | GOAL | OTHER (se valida en la capa de features).
  category  String   @default("OTHER")
  content   String
  /// CHAT (lo aprendió el coach) o USER (lo escribió la persona).
  source    String   @default("CHAT")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("coach_memory")
}

model PhysiqueAnalysis {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Informe estructurado (ver src/features/coach-profile/physique-schema.ts).
  report     Json
  photoCount Int      @default(1) @map("photo_count")
  /// Lo que el usuario aclaró al pedir el análisis.
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("physique_analysis")
}

/// Una competencia / evento del usuario. `priority` A = objetivo principal,
/// B = importante, C = de preparación.
model Competition {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid @map("user_id")
  user           Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sportProfileId String?       @db.Uuid @map("sport_profile_id")
  sportProfile   SportProfile? @relation(fields: [sportProfileId], references: [id], onDelete: SetNull)
  name           String
  date           DateTime      @db.Date
  priority       String        @default("B")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([userId, date])
  @@map("competition")
}

/// Perfil de coaching detallado: preferencias del cliente para que los planes de
/// dieta y entrenamiento sean 100% individualizados. Todo opcional; se completa
/// de a poco. Cada sección es un JSON validado por Zod en la capa de features.
model CoachProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid @map("user_id")
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  health    Json     @default("{}")
  food      Json     @default("{}")
  training  Json     @default("{}")
  goal      Json     @default("{}")
  lifestyle Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("coach_profile")
}

// ---------------------------------------------------------------------
// IA
// ---------------------------------------------------------------------

model AiConversation {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid @map("user_id")
  user      Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AiConversationKind @default(COACH)
  title     String?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  messages  AiMessage[]

  @@index([userId, kind])
  @@map("ai_conversation")
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid @map("conversation_id")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiRole
  content        String
  toolCalls      Json?          @map("tool_calls")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("ai_message")
}

/// Contenido generado por IA + hash de entrada para cache de resultados.
model AiGeneration {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @db.Uuid @map("user_id")
  user       Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       AiGenerationKind
  inputHash  String             @map("input_hash")
  payload    Json
  status     AiGenerationStatus @default(DRAFT)
  acceptedAt DateTime?          @map("accepted_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([userId, kind])
  @@index([userId, inputHash])
  @@map("ai_generation")
}

/// Borrador de acción propuesta por IA. Nada se escribe hasta que el usuario
/// confirma (`confirmAiActionDraft`).
model AiActionDraft {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid @map("user_id")
  user        Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        AiDraftKind
  payload     Json
  status      AiDraftStatus @default(PROPOSED)
  expiresAt   DateTime      @map("expires_at")
  confirmedAt DateTime?     @map("confirmed_at")
  appliedAt   DateTime?     @map("applied_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([userId, status])
  @@map("ai_action_draft")
}

/// Metering diario para rate-limit freemium. Chequeado ANTES de llamar al modelo.
model AiUsageDaily {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  user         Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  day          DateTime @db.Date
  task         String
  model        String
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costUsd      Decimal  @default(0) @db.Decimal(12, 6) @map("cost_usd")
  messageCount Int      @default(0) @map("message_count")

  @@unique([userId, day, task, model])
  @@index([userId, day])
  @@map("ai_usage_daily")
}

model WeeklyCheckin {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid @map("user_id")
  user                Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart           DateTime      @db.Date @map("week_start")
  /// Lo que cubre la revisión: desde el día siguiente a la revisión anterior hasta el día en que se hizo
  /// (no la semana calendario). Las revisiones viejas no lo tienen: se toma la semana de `weekStart`.
  periodStart         DateTime?     @db.Date @map("period_start")
  periodEnd           DateTime?     @db.Date @map("period_end")
  avgWeightKg         Float?        @map("avg_weight_kg")
  weightChangeKg      Float?        @map("weight_change_kg")
  kcalAdherencePct    Float?        @map("kcal_adherence_pct")
  proteinAdherencePct Float?        @map("protein_adherence_pct")
  workoutsCompleted   Int           @default(0) @map("workouts_completed")
  workoutsPlanned     Int           @default(0) @map("workouts_planned")
  hunger              Int?
  energy              Int?
  sleep               Int?
  trainingFeel        Int?          @map("training_feel")
  dietAdherence       Int?          @map("diet_adherence")
  stress              Int?
  outsideActivity     Int?          @map("outside_activity")
  adherenceNote       String?       @map("adherence_note")
  notes               String?
  aiSummary           String?       @map("ai_summary")
  /** Análisis de las fotos de físico. Las fotos NO se guardan: sólo este texto. */
  aiPhotoNote         String?       @map("ai_photo_note")
  aiProposal          Json?         @map("ai_proposal")
  /** Propuesta de progresión de entrenamiento (call + resumen + ajustes por ejercicio). */
  aiTrainingProposal  Json?         @map("ai_training_proposal")
  status              CheckinStatus @default(DRAFT)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
  @@map("weekly_checkin")
}

// ---------------------------------------------------------------------
// GAMIFICACIÓN / NOTIFICACIONES
// ---------------------------------------------------------------------

/// Catálogo de logros (lectura pública). Se llena en el seed.
model Achievement {
  key         String            @id
  category    String
  title       String
  description String
  icon        String?
  threshold   Int?
  createdAt   DateTime          @default(now()) @map("created_at")
  users       UserAchievement[]

  @@map("achievement")
}

model UserAchievement {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid @map("user_id")
  user           Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementKey String      @map("achievement_key")
  achievement    Achievement @relation(fields: [achievementKey], references: [key], onDelete: Cascade)
  progress       Int         @default(0)
  unlockedAt     DateTime?   @map("unlocked_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@unique([userId, achievementKey])
  @@index([userId])
  @@map("user_achievement")
}

model NotificationPreference {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid @map("user_id")
  user      Profile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  enabled   Boolean             @default(true)
  timeOfDay String?             @map("time_of_day")
  /** Día de la semana para recordatorios semanales (1 = lunes … 7 = domingo). */
  dayOfWeek Int?                @map("day_of_week")
  channel   NotificationChannel @default(IN_APP)
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@unique([userId, kind])
  @@map("notification_preference")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid @map("user_id")
  user         Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         NotificationKind
  title        String
  body         String?
  url          String?
  scheduledFor DateTime         @map("scheduled_for")
  sentAt       DateTime?        @map("sent_at")
  readAt       DateTime?        @map("read_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([userId, scheduledFor])
  @@index([userId, readAt])
  @@index([sentAt])
  @@map("notification")
}

/// Gimnasio que quiere usar Forza AI para sus socios. Se anota solo (PENDING); el admin lo aprueba,
/// le fija el cupo de socios y se genera su código. SUSPENDED o REJECTED = sus socios pierden el acceso.
model Gym {
  id                  String      @id @default(uuid()) @db.Uuid
  name                String
  city                String?
  contactName         String      @map("contact_name")
  contactEmail        String      @map("contact_email")
  contactPhone        String?     @map("contact_phone")
  /// Cuántos socios dice tener (dato del formulario, sólo orientativo).
  memberEstimate      Int?        @map("member_estimate")
  message             String?
  /// PENDING | ACTIVE | SUSPENDED | REJECTED
  status              String      @default("PENDING")
  /// Máximo de socios activos. 0 hasta que el admin lo fija al aprobar.
  memberLimit         Int         @default(0) @map("member_limit")
  inviteCode          String?     @unique @map("invite_code")
  /// Máquinas y equipamiento que el gimnasio dice tener (para armar rutinas con eso).
  equipment           Json?
  /// Especialidad: crossfit, hipertrofia, funcional, deportes...
  specialty           String?
  createdAt           DateTime    @default(now()) @map("created_at")
  approvedAt          DateTime?   @map("approved_at")
  /// Lo que paga el gimnasio por cada socio que entró con su código, por mes (US$).
  pricePerMember      Decimal     @default(5000) @db.Decimal(8, 2) @map("price_per_member_usd")
  /// Moneda en la que paga el gimnasio: ARS (pesos argentinos) o USD.
  currency            String      @default("ARS")
  /// Cuenta de Forza AI del dueño del gimnasio (la fija el admin). Una misma cuenta puede ser socia de un
  /// gimnasio y dueña de otro: son dos roles aparte.
  ownerUserId         String?     @db.Uuid @map("owner_user_id")
  owner               Profile?    @relation("GymOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  members             GymMember[]
  invites             GymInvite[]
  clients             GymClient[]
  payments            GymPayment[]
  routines            GymRoutine[]
  referrals           GymReferral[]
  webSubscriptions    WebSubscription[]
  challenges          GymChallenge[]
  classes             GymClass[]
  /// Color de la marca (#rrggbb) y logo (dirección pública), para lo que ve el socio dentro de la app.
  brandColor          String?     @map("brand_color")
  logoUrl             String?     @map("logo_url")
  /// Cómo le pagan sus clientes: un link de pago (se vuelve QR) y un alias o CBU para transferir.
  paymentLink         String?     @map("payment_link")
  paymentAlias        String?     @map("payment_alias")
  /// Segundo cobro del gimnasio: el plan de rutina con IA que sus clientes pagan aparte (link de pago y valor).
  paymentPlanLink     String?     @map("payment_plan_link")
  paymentPlanAmount   Decimal?    @db.Decimal(12, 2) @map("payment_plan_amount")
  /// Cuándo aceptó los términos para gimnasios y cuál versión.
  termsAcceptedAt     DateTime?   @map("terms_accepted_at")
  termsVersion        String?     @map("terms_version")

  @@index([status])
  @@index([ownerUserId])
  @@map("gym")
}

/// Un socio dentro de un gimnasio. Una persona está en un solo gimnasio a la vez.
model GymMember {
  id        String    @id @default(uuid()) @db.Uuid
  gymId     String    @db.Uuid @map("gym_id")
  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId    String    @unique @db.Uuid @map("user_id")
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ACTIVE | ENDED | LAPSED (cuota del gimnasio vencida: sin acceso hasta que pague)
  status    String    @default("ACTIVE")
  /// El socio dejó que su gimnasio vea su nombre y cuándo entrenó por última vez (apagado por defecto).
  shareActivity Boolean @default(false) @map("share_activity")
  joinedAt  DateTime  @default(now()) @map("joined_at")
  endedAt   DateTime? @map("ended_at")

  @@index([gymId, status])
  @@map("gym_member")
}

/// Un cliente del gimnasio (con o sin Forza AI): lo carga el dueño para llevar el control de las cuotas. No es un
/// usuario de la app; si tiene mail y ese mail es de un socio de Forza AI, se enlazan por el mail.
model GymClient {
  id         String    @id @default(uuid()) @db.Uuid
  gymId      String    @db.Uuid @map("gym_id")
  gym        Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name       String
  /// En minúsculas.
  email      String?
  phone      String?
  /// Lo que paga por mes (en la moneda del gimnasio; es sólo de referencia para el dueño).
  feeAmount  Decimal?  @db.Decimal(12, 2) @map("fee_amount")
  /// Día en que vence su cuota (el día que le toca volver a pagar). Null = todavía sin controlar.
  paidUntil  DateTime? @db.Date @map("paid_until")
  note       String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  payments   GymClientPayment[]

  @@index([gymId, active])
  @@index([email])
  @@map("gym_client")
}

/// Rutina oficial del gimnasio: la arma el profe y la ven los socios en la app. `days` es una lista de
/// { name, exercises: [{ name, sets, reps, note }] }.
model GymRoutine {
  id          String   @id @default(uuid()) @db.Uuid
  gymId       String   @db.Uuid @map("gym_id")
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  title       String
  description String?
  level       String?
  days        Json
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([gymId, active])
  @@map("gym_routine")
}

/// Reto del gimnasio: un desafío entre sus socios entre dos fechas. El puntaje sale de los entrenamientos que
/// cada socio que se sumó completa en la app (metric: WORKOUTS = entrenamientos, DAYS = días distintos).
model GymChallenge {
  id          String   @id @default(uuid()) @db.Uuid
  gymId       String   @db.Uuid @map("gym_id")
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  title       String
  description String?
  metric      String   @default("WORKOUTS")
  startsOn    DateTime @db.Date @map("starts_on")
  endsOn      DateTime @db.Date @map("ends_on")
  /// Premio para quien gane (texto libre, lo entrega el gimnasio).
  prize       String?
  createdAt   DateTime @default(now()) @map("created_at")
  entries     GymChallengeEntry[]

  @@index([gymId, endsOn])
  @@map("gym_challenge")
}

/// Un socio que se sumó a un reto (al sumarse acepta aparecer en el ranking con su nombre y la inicial del apellido).
model GymChallengeEntry {
  id          String       @id @default(uuid()) @db.Uuid
  challengeId String       @db.Uuid @map("challenge_id")
  challenge   GymChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String       @db.Uuid @map("user_id")
  user        Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime     @default(now()) @map("joined_at")

  @@unique([challengeId, userId])
  @@index([userId])
  @@map("gym_challenge_entry")
}

/// Clase del gimnasio con reserva: se repite cada semana el mismo día (weekday: 1 = lunes … 7 = domingo) a la misma
/// hora (start_time "HH:MM", hora de Argentina). Una fila por día y horario.
model GymClass {
  id          String   @id @default(uuid()) @db.Uuid
  gymId       String   @db.Uuid @map("gym_id")
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name        String
  description String?
  instructor  String?
  weekday     Int
  startTime   String   @map("start_time")
  durationMin Int      @default(60) @map("duration_min")
  capacity    Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  bookings    GymBooking[]

  @@index([gymId, active])
  @@map("gym_class")
}

/// Reserva de un socio para UNA fecha concreta de una clase. BOOKED | CANCELLED.
model GymBooking {
  id          String    @id @default(uuid()) @db.Uuid
  classId     String    @db.Uuid @map("class_id")
  class       GymClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid @map("user_id")
  user        Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  status      String    @default("BOOKED")
  createdAt   DateTime  @default(now()) @map("created_at")
  cancelledAt DateTime? @map("cancelled_at")

  @@unique([classId, userId, date])
  @@index([classId, date, status])
  @@index([userId, date])
  @@map("gym_booking")
}

/// De qué gimnasio vino una persona que activó su plan por la web (el QR del gimnasio lleva a su página). Una por persona.
model GymReferral {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid @map("user_id")
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymId     String   @db.Uuid @map("gym_id")
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([gymId])
  @@map("gym_referral")
}

/// Plan mensual que una persona paga directo por la web (hoy Mercado Pago, en pesos). Una por persona. `providerId`
/// es el id de la suscripción en el proveedor; `status`: PENDING | AUTHORIZED | PAUSED | CANCELLED. Solo AUTHORIZED
/// da acceso (lo mismo que un socio de gimnasio). `gymId` es el gimnasio de donde vino (su QR), solo para reportes.
model WebSubscription {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique @db.Uuid @map("user_id")
  user          Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String    @default("MERCADOPAGO")
  providerId    String    @unique @map("provider_id")
  status        String    @default("PENDING")
  gymId         String?   @db.Uuid @map("gym_id")
  gym           Gym?      @relation(fields: [gymId], references: [id], onDelete: SetNull)
  nextPaymentAt DateTime? @map("next_payment_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("web_subscription")
}

/// Un pago de cuota registrado por el dueño.
model GymClientPayment {
  id        String    @id @default(uuid()) @db.Uuid
  clientId  String    @db.Uuid @map("client_id")
  client    GymClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  paidOn    DateTime  @db.Date @map("paid_on")
  amount    Decimal?  @db.Decimal(12, 2)
  /// Cuántos meses cubre este pago.
  months    Int       @default(1)
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([clientId])
  @@map("gym_client_payment")
}

/// Invitación a un socio por mail. El gimnasio carga el mail (PENDING), el admin la aprueba (APPROVED: se le
/// manda el mail y reserva un lugar del cupo), y cuando la persona entra con ese mail y acepta queda JOINED.
model GymInvite {
  id           String    @id @default(uuid()) @db.Uuid
  gymId        String    @db.Uuid @map("gym_id")
  gym          Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  /// Siempre en minúsculas.
  email        String
  /// PENDING | APPROVED | REJECTED | JOINED
  status       String    @default("PENDING")
  requestedAt  DateTime  @default(now()) @map("requested_at")
  decidedAt    DateTime? @map("decided_at")
  joinedAt     DateTime? @map("joined_at")
  /// Si el mail de invitación salió bien al aprobar.
  emailSent    Boolean   @default(false) @map("email_sent")
  /// Cuándo el administrador confirmó que el gimnasio pagó este alta (el comprobante le llega por mail o WhatsApp).
  /// Sin pago confirmado no se puede aprobar.
  paidAt       DateTime? @map("paid_at")

  @@unique([gymId, email])
  @@index([status])
  @@index([email])
  @@map("gym_invite")
}

/// Cobro mensual a un gimnasio (se arma solo al abrir el panel de cobros, un registro por gimnasio y mes).
/// Mientras está PENDING el monto sigue la cantidad de socios; al marcarlo PAID queda fijo.
model GymPayment {
  id                 String    @id @default(uuid()) @db.Uuid
  gymId              String    @db.Uuid @map("gym_id")
  gym                Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  /// Mes que se cobra, "2026-11".
  period             String
  members            Int
  pricePerMember     Decimal   @db.Decimal(8, 2) @map("price_per_member_usd")
  amount             Decimal   @db.Decimal(10, 2) @map("amount_usd")
  /// ARS | USD (la moneda del gimnasio cuando se armó el cobro).
  currency           String    @default("USD")
  dueDate            DateTime  @db.Date @map("due_date")
  /// PENDING | PAID
  status             String    @default("PENDING")
  paidAt             DateTime? @map("paid_at")
  note               String?
  createdAt          DateTime  @default(now()) @map("created_at")

  @@unique([gymId, period])
  @@index([status, dueDate])
  @@map("gym_payment")
}

/// Errores que ve la gente (de la app y del servidor), agrupados: un registro por error distinto,
/// con cuántas veces pasó. Se ven y se marcan como resueltos en /admin/errores.
model AppError {
  id          String    @id @default(uuid()) @db.Uuid
  /// Huella para agrupar el mismo error (origen + mensaje + ruta sin ids).
  fingerprint String    @unique
  /// server | client
  source      String
  message     String
  stack       String?
  path        String?
  digest      String?
  userId      String?   @db.Uuid @map("user_id")
  userAgent   String?   @map("user_agent")
  count       Int       @default(1)
  firstSeen   DateTime  @default(now()) @map("first_seen")
  lastSeen    DateTime  @default(now()) @map("last_seen")
  /// OPEN | RESOLVED
  status      String    @default("OPEN")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([status, lastSeen])
  @@map("app_error")
}

/// Token de notificaciones remotas de la app nativa (APNs en iPhone). Un token pertenece a un solo
/// usuario: si otra cuenta inicia sesión en el mismo teléfono, la fila pasa a ella.
model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("ios")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("device_token")
}

/// Suscripción Web Push de un navegador. Se envía el aviso a cada endpoint;
/// si el push service responde 404/410 la fila se borra.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("push_subscription")
}
